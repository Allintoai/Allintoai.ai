{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allintoai-ai",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "keep_vars": true,
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
